{
  "name": "tt-music",
  "version": "1.21.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "prebuild": "node scripts/update-build-hash.js",
    "build": "rimraf server && tsc --project tsconfig.json && tsc-alias -p tsconfig.json",
    "prestart": "node scripts/update-build-hash.js",
    "start": "node ./index.js",
    "predev": "node scripts/update-build-hash.js",
    "dev": "nodemon",
    "prd": "pm2 start ecosystem.config.js --env production",
    "publish": "node publish",
    "electron:dev": "npm run build && electron .",
    "electron:debug": "npm run build && electron --inspect=5858 .",
    "electron:build": "npm run build",
    "electron:dist": "npm run electron:build && electron-builder --win --mac --config.npmRebuild=false",
    "electron:dist:mac": "npm run electron:build && electron-builder --mac",
    "electron:dist:win": "npm run electron:build && electron-builder --win --config.npmRebuild=false",
    "electron:dist:linux": "npm run electron:build && electron-builder --linux --config.npmRebuild=false",
    "electron:dist:all": "npm run electron:build && electron-builder --win --linux --mac --config.npmRebuild=false"
  },
  "engines": {
    "node": ">= 16",
    "npm": ">= 8.5.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XCQ0607/lxserver.git"
  },
  "author": {
    "name": "XCQ",
    "email": "2406498704@qq.com"
  },
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/XCQ0607/lxserver/issues"
  },
  "homepage": "https://github.com/XCQ0607/lxserver#readme",
  "dependencies": {
    "@foobar404/wave": "^2.0.5",
    "@lox-audioserver/node-airplay-sender": "^0.4.10",
    "@types/formidable": "^3.4.6",
    "archiver": "^6.0.1",
    "bonjour-hap": "^3.10.3",
    "bufferutil": "^4.0.8",
    "chokidar": "^3.6.0",
    "crypto-js": "^4.2.0",
    "fast-xml-parser": "^5.9.3",
    "ffmpeg-static": "^5.3.0",
    "formidable": "^3.5.4",
    "log4js": "^6.9.1",
    "lru-cache": "^10.0.1",
    "message2call": "^0.1.3",
    "module-alias": "^2.2.3",
    "music-tag-native": "^0.2.1",
    "needle": "^3.3.1",
    "radio-browser": "^2.2.3",
    "rusty-chromaprint-wasm": "^0.1.5",
    "socks-proxy-agent": "^10.0.0",
    "sql.js": "^1.14.1",
    "tunnel": "^0.0.6",
    "unzipper": "^0.11.6",
    "utf-8-validate": "^6.0.3",
    "vm2": "^3.10.3",
    "webdav": "^5.3.0",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "@tsconfig/node16": "^16.1.1",
    "@types/archiver": "^7.0.0",
    "@types/module-alias": "^2.0.4",
    "@types/needle": "^3.3.0",
    "@types/tunnel": "^0.0.7",
    "@types/unzipper": "^0.10.11",
    "@types/ws": "8.5.4",
    "chalk": "^4.1.2",
    "changelog-parser": "^3.0.1",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3",
    "eslint-config-standard-with-typescript": "^39.1.1",
    "nodemon": "^3.0.1",
    "rimraf": "^5.0.5",
    "sharp": "^0.33.4",
    "stylelint": "^17.6.0",
    "stylelint-config-standard": "^40.0.0",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.8",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.2.2"
  },
  "nodemonConfig": {
    "ext": "js,ts",
    "ignore": [
      "data/",
      "logs/",
      "cache/",
      "temp/",
      "backup/",
      "download/",
      "local/",
      "server/",
      "config.js"
    ],
    "exec": "npx tsx ./src/index.ts"
  }
}
