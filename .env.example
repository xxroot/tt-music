# 可选配置文件：cp .env.example .env
# .env 已被 .gitignore / .dockerignore 排除，不会入库、也不会进入镜像层。
#
# 默认（下面 3 项全部留空）：首次打开网页会进入 /setup 初始化向导，
# 由你自己设置管理员密码。密码写入数据卷 data/config.js，重启后仍然有效。
#
# 只有在需要「预置密码 / 无人值守部署」时才填写。
# 一旦填写 ADMIN_PASSWORD 就会跳过初始化向导；且环境变量优先级高于
# data/config.js，会覆盖向导里曾经设置过的密码。

# 管理后台密码（对应 FRONTEND_PASSWORD）；留空 = 走 /setup 向导
ADMIN_PASSWORD=

# Web 播放器密码（对应 WEBPLAYER_PASSWORD）；留空且不预置时，播放器鉴权由向导决定
PLAYER_PASSWORD=

# 同步服务连接密码（对应 LX_USER_admin，变量名中的 admin 即同步账号名）
# 留空 = 不创建同步用户，可稍后在管理后台「用户管理」中添加
SYNC_PASSWORD=

# 镜像地址（可选）：默认取 docker-compose.yml 里的地址，通常不用填。
# 只有想临时换镜像或固定某个版本时才填，例如：
# DOCKER_IMAGE=yourname/tt-music:v1.2.0

# 架构无需配置：GitHub Actions 推送的是 amd64 + arm64 双架构 manifest，
# 各设备 docker compose up -d 会自动拉取匹配自身架构的层。
